theme_override_font_sizes/font_size = 45
text = "Visitantes"

[node name="RichTextLabel2" type="RichTextLabel" parent="CanvasLayer/LibretaUI/Pagina4" unique_id=1792171912]
layout_mode = 0
offset_left = 305.99997
offset_top = 151.0
offset_right = 557.0
offset_bottom = 499.846
rotation = 0.008256528
theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "12 de abril de 20013
¿Qué es lo que nos hace sentir que estamos vivos?

¿Respirar? ¿Reír? Llorar?

 Desde que llegué aquí siempre he escuchado risas y sollozos. Creí que eran intrusos gastandome alguna broma, pero no. Eran las estatas. Están vivas.

Mejor dicho, cobran vida."

[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/LibretaUI/Pagina4" unique_id=931169480]
layout_mode = 0
offset_left = 610.0
offset_top = 151.0
offset_right = 862.0
offset_bottom = 486.10614
rotation = -0.01769208
theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "Están hechas de piedra, pero hay momentos en los que lágrimas nacen de sus ojos.

Cuando las estatuas muestran emociones son muy agresivas, aunque he conseguido regresarlas a la normalidad con la linterna.

[b][u]Recuerda: [/u][/b]
Si las estatuas son emocionales, usa la linterna. De otra forma no son más que piedra."

[node name="Pagina5" type="Panel" parent="CanvasLayer/LibretaUI" unique_id=2023667027]
visible = false
layout_mode = 0
offset_right = 40.0
offset_bottom = 40.0

