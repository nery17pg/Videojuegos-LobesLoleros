anchor_bottom = 7.8
offset_left = -131.0
offset_top = -167.0
offset_right = 140.0
offset_bottom = 194.0
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Hay un hombre de la tarcera edad bastante misterioso, se molesta cuando trato de preguntar más sobre él.
Está familiarizado con la niña, pero no he podido descifrar qué clase de conexión tienen.

Por último, pero no menos importante, mi nieta suele venir a visitarme.  Se molesta cuando digo que su abuelo está muy viejo para eso"
autowrap_mode = 3

[node name="AnomaliesGhoul" type="Sprite2D" parent="CanvasLayer/LibretaUI/Pagina9" unique_id=304849829]
