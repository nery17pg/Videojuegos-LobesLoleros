offset_right = 133.0
offset_bottom = 165.99997
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Mujer:

Es la nieta del antiguo velador
 ya fallecido, deambula por el
 cementerio con la esperanza 
de encontrarse con su abuelo "

[node name="RichTextLabel2" type="RichTextLabel" parent="CanvasLayer/LibretaUI/Pagina6" unique_id=421162660]
layout_mode = 0
offset_left = 305.99997
offset_top = 151.0
offset_right = 557.0
offset_bottom = 499.846
rotation = 0.008256528
theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "15 de junio de 2016
Mi nieta ha crecido tanto, es una niña increíble.
A veces pienso en que si la niña de este cementerio no hubiera muerto, sería igual a mi nieta. 

A todo esto, si llegas a encontrarte al ente que mencioné, jamas digas algo negativo de su madre y trata de no ignorarla. 

Es una de las criaturas más peligrosas de este lugar."

[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/LibretaUI/Pagina6" unique_id=382460183]
layout_mode = 0
offset_left = 610.0
offset_top = 151.0
offset_right = 862.0
offset_bottom = 486.10614
rotation = -0.01769208
theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "Una vez cometí el eror tocar al peluche que lleva a todos lados. 

Terminé en el hospital con heridas mortales.

[b][u]Recuerda:[/u] [/b]
No hagas enojar a la niña, de otra forma podrías no correr con la misma suerte que yo"

