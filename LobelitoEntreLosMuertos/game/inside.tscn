theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "17 de octubre de 2001
No ha pasado mucho tiempo 
desde que comencé a trabajar 
en el cementerio, pero estoy 
seguro de que lo he visto todo.
Llevaré un registro de los
descubrimientos que he hecho.

El cementerio parece obsesionado
conmigo, me veo en todas partes.
Mi nombre escrito en una lápida,
mi cara en lugares que no debería,
e incluso un clon."
vertical_alignment = 1

[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/LibretaUI/Pagina1" unique_id=146875037]
layout_mode = 0
offset_left = 610.0
offset_top = 151.0
offset_right = 862.0
offset_bottom = 456.0
rotation = -0.016992124
theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "Y ni siquiera es lo más extraño
que he visto por aquí.

[b][u]Recordar[/u][/b]
Cuando te veas a ti mismo,
reporta la anomalía bajo tu
nombre
"

[node name="Pagina2" type="Panel" parent="CanvasLayer/LibretaUI" unique_id=901331056]
visible = false
layout_mode = 0
offset_right = 40.0
offset_bottom = 40.0

[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/LibretaUI/Pagina2" unique_id=419452384]
layout_mode = 0
offset_left = 610.0
offset_top = 151.0
offset_right = 862.0
offset_bottom = 456.0
rotation = -0.016992124
theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "15 de diciembre de 2003
Esta noche el cementerio ha estado muy tranquilo, a diferencia de otros días que esas... cosas.... empiezan a molestar cambiando  o modificando [u]objetos[/u]

Por supuesto, me parecen criaturas facinantes. Pero tener que reportar cada uno de los objetos es una molestia."

