[node name="RichTextLabel2" type="RichTextLabel" parent="CanvasLayer/LibretaUI/Pagina5" unique_id=1113085150]
layout_mode = 0
offset_left = 305.99997
offset_top = 151.0
offset_right = 557.0
offset_bottom = 499.846
rotation = 0.008256528
theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "01 de julio de 2016
Debo admitir que más que un diario, esto es un manual de instrucciones para los siguientes veladores.  Cuando tomé el puesto no tenía ni idea de lo que me esperaba. 

Nadie me advirtió.
Nadie me aconsejó

Es por eso que he decicido tomar el papel de mentor, aunque sea madiante este escrito."

[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/LibretaUI/Pagina5" unique_id=424135387]
layout_mode = 0
offset_left = 610.0
offset_top = 151.0
offset_right = 862.0
offset_bottom = 486.10614
rotation = -0.01769208
theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "Las muñecas suelen preferir coexistir en paz con los vivos, sin embargo algo ha cambiado. Si bien siguen ocultandose para jugar, si fallas al reportarlo se pondrán agresivas.

[u][b]Recuerda:[/b][/u]
Las muñecas no tienen una categoría específica ya que no son entes, visitantes, ni objetos."

[node name="Pagina6" type="Panel" parent="CanvasLayer/LibretaUI" unique_id=1121147678]
visible = false
layout_mode = 0
offset_right = 40.0
offset_bottom = 40.0

[node name="Label" type="Label" parent="CanvasLayer/LibretaUI/Pagina6" unique_id=1166309994]
visible = false
layout_mode = 1
anchors_preset = -1
