text = "Anciano:"

[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/LibretaUI/Pagina7" unique_id=1306476353]
layout_mode = 0
offset_left = 610.0
offset_top = 151.0
offset_right = 862.0
offset_bottom = 486.10614
rotation = -0.01769208
theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "18 de febrero de 2018
Es la primera vez que veo una neblina tan espesa que se forme en cuestión de segundos.

Estaba pensando en cómo debería reportarla cuando mi linterna comenzó a fallar y parpadear.

Curiosamente la neblina se disolvió inmediatamente."

[node name="Pagina8" type="Panel" parent="CanvasLayer/LibretaUI" unique_id=899416508]
visible = false
layout_mode = 0
offset_right = 40.0
offset_bottom = 40.0

[node name="RichTextLabel2" type="RichTextLabel" parent="CanvasLayer/LibretaUI/Pagina8" unique_id=1000717215]
layout_mode = 0
offset_left = 305.99997
offset_top = 151.0
offset_right = 557.0
offset_bottom = 499.846
rotation = 0.008256528
theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "09 de abril de 2019
Si bien la niña es el ente más peligroso, no es la única. 

Hay dos entes más que son especialmente fastidiosos

Uno de ellos es el Oni, es algo insoportable, así que trata de seguirle el juego y nunca ignorarle. 

El otro es el Ghoul, una verdadera bestia."

[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/LibretaUI/Pagina8" unique_id=892347411]
layout_mode = 0
offset_left = 610.0
offset_top = 151.0
offset_right = 862.0
offset_bottom = 500.29294
rotation = -0.01769208
theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "No puedes olvidar ni por un segundo que eres una presa, actúa inteligentemente.

He logrado vivir hasta hoy gracias a la extraña jerarquía que hay en este cementerio.

Un conejito de felpa siendo respetado por criaturas de tal calibre... Definitivamente ya lo he visto todo

Mi mejor consejo es que no intentes escapar, será peor.
"

[node name="Pagina9" type="Panel" parent="CanvasLayer/LibretaUI" unique_id=209167479]
visible = false
layout_mode = 0
offset_right = 40.0
offset_bottom = 40.0

[node name="Label" type="Label" parent="CanvasLayer/LibretaUI/Pagina9" unique_id=1014666164]
layout_mode = 1
anchors_preset = -1
anchor_left = 18.475
anchor_top = 7.8
