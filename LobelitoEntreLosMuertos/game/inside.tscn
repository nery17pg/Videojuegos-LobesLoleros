rotation = 0.008256528
theme_override_colors/default_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "13 de enero de 2020
Hay personas que frecuentan el cementerio, incluso a altas horas de la noche.

El más llamativo es sin duda un hombre sombrío, siempre va por ahí diciendo tonterias sobre fantasmas. Si pudiera, ¡Le daría mi trabajo!

Ha intentado asesinarme un par de veces tras ser demasiado directo."

